import { base44 } from '@/api/base44Client';
import { useState } from 'react';

/**
 * Hook pour générer un lien OG shareable pour un produit
 * Retourne le lien social optimisé pour WhatsApp/Facebook preview
 */
export function useProductOGLink() {
  const [loading, setLoading] = useState(false);

  const generateLink = async (productId, shopId) => {
    if (!productId || !shopId) return null;
    
    setLoading(true);
    try {
      const response = await base44.functions.invoke('generateOGLink', {
        product_id: productId,
        shop_id: shopId
      });
      
      return response?.data?.ogLink || null;
    } catch (error) {
      console.error('Error generating OG link:', error);
      return null;
    } finally {
      setLoading(false);
    }
  };

  return { generateLink, loading };
}