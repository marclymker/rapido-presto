rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'makariosentreprises@gmail.com';
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }
    match /users/{uid}/products/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || (signedIn()
        && firestore.get(/databases/(default)/documents/Product/$(productId)).data.owner_id == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)'));
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
