{
  "name": "IA Auto-Reply Chat",
  "description": "R\u00e9pond automatiquement aux messages clients avec l'IA",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ChatMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ia_auto_reply_chat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoReplyChat",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoReplyChat"
  }
}