{
  "name": "Auto-publish blog sur Facebook & Instagram",
  "description": "Publie automatiquement un article sur Facebook et Instagram quand il passe de brouillon \u00e0 publi\u00e9",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "BlogArticle"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_publish_blog_sur_facebook_instagram",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoPublishBlogOnPublish",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoPublishBlogOnPublish"
  }
}