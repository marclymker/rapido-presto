{
  "name": "Notify Order Shipped (WhatsApp)",
  "description": "Quand une commande passe au statut \"in_delivery\" (exp\u00e9di\u00e9e), l'agent envoie un message WhatsApp au client avec le lien de suivi et les infos cl\u00e9s.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"in_delivery\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_order_shipped_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyOrderShipped",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyOrderShipped"
  }
}