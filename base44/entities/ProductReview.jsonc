{
  "name": "ProductReview",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID du produit"
    },
    "user_name": {
      "type": "string",
      "description": "Nom de l'auteur de l'avis"
    },
    "rating": {
      "type": "number",
      "description": "Note de 1 \u00e0 5",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "description": "Commentaire du client"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description d\u00e9taill\u00e9e de l'exp\u00e9rience avec ce produit"
    },
    "is_approved": {
      "type": "boolean",
      "default": true,
      "description": "Avis approuv\u00e9 (mod\u00e9ration)"
    }
  },
  "required": [
    "product_id",
    "rating"
  ]
}