{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "ID du client"
    },
    "customer_name": {
      "type": "string",
      "description": "Nom du client"
    },
    "vendor_id": {
      "type": "string",
      "description": "ID du vendeur"
    },
    "shop_id": {
      "type": "string",
      "description": "ID de la boutique"
    },
    "shop_name": {
      "type": "string",
      "description": "Nom de la boutique"
    },
    "shop_logo": {
      "type": "string",
      "description": "Logo de la boutique"
    },
    "last_message": {
      "type": "string",
      "description": "Aper\u00e7u du dernier message"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier message"
    },
    "product_context_id": {
      "type": "string",
      "description": "Produit \u00e0 l'origine de la conversation"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes ou contexte suppl\u00e9mentaire sur cette conversation"
    }
  },
  "required": [
    "customer_id",
    "vendor_id",
    "shop_id"
  ]
}