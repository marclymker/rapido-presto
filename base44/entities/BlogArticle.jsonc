{
  "name": "BlogArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'article"
    },
    "slug": {
      "type": "string",
      "description": "Slug unique pour l'URL (ex: mon-article-seo)"
    },
    "excerpt": {
      "type": "string",
      "description": "Extrait court de l'article (pour la liste)"
    },
    "content": {
      "type": "string",
      "description": "Contenu complet de l'article en Markdown"
    },
    "cover_image_url": {
      "type": "string",
      "description": "URL de l'image de couverture"
    },
    "cover_image_alt": {
      "type": "string",
      "description": "Texte alternatif de l'image (SEO)"
    },
    "published_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de publication"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Article publi\u00e9 ou brouillon"
    },
    "seo_description": {
      "type": "string",
      "description": "Meta description pour Google (160 caract\u00e8res)"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mots-cl\u00e9s SEO"
    },
    "related_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs des produits li\u00e9s \u00e0 cet article"
    },
    "author": {
      "type": "string",
      "default": "Rapido Presto",
      "description": "Auteur de l'article"
    },
    "social_published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la derni\u00e8re publication sur les r\u00e9seaux sociaux"
    }
  },
  "required": [
    "title",
    "slug",
    "content",
    "cover_image_url",
    "published_date"
  ]
}