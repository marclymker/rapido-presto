{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'article"
    },
    "slug": {
      "type": "string",
      "description": "Identifiant unique pour l'URL du produit"
    },
    "price": {
      "type": "number",
      "description": "Prix en HTG"
    },
    "promo_price": {
      "type": "number",
      "description": "Prix promotionnel en HTG"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Image principale"
    },
    "image_alt": {
      "type": "string",
      "description": "Texte alternatif de l'image principale (SEO & accessibilit\u00e9)"
    },
    "additional_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Images suppl\u00e9mentaires"
    },
    "category": {
      "type": "string",
      "enum": [
        "Fastfood",
        "Mode",
        "Boutique Fleurs",
        "Pharmacie",
        "Mariage",
        "Epicerie",
        "Caf\u00e9",
        "Pour Femme",
        "Electronics",
        "Pour homme",
        "Maison",
        "B\u00e9b\u00e9",
        "Outils",
        "Bijoux",
        "Mat\u00e9riels D\u00e9cor"
      ],
      "description": "Type d'article (peut diff\u00e9rer de la cat\u00e9gorie de la boutique)"
    },
    "fb_category_id": {
      "type": "number",
      "description": "ID de la cat\u00e9gorie Facebook/Google Product Taxonomy (ex: 225 pour Smartphones)"
    },
    "fb_category_path": {
      "type": "string",
      "description": "Chemin complet de la cat\u00e9gorie FB (ex: \u00c9lectronique > T\u00e9l\u00e9phonie > Smartphones)"
    },
    "subcategory": {
      "type": "string",
      "enum": [
        "Robe Sir\u00e8ne",
        "Robe Catalina",
        "Robe Ponpon (Princesse)",
        "Robe de C\u00e9r\u00e9monie",
        "Demoiselle d'honneur",
        "T\u00e9moins",
        "Bague de Mariage",
        "Bague",
        "Accessoires",
        "Carte et programmation",
        "Mat\u00e9riels D\u00e9cor"
      ],
      "description": "Sous-cat\u00e9gorie sp\u00e9cifique pour les articles de mariage."
    },
    "taille_emballage": {
      "type": "string",
      "enum": [
        "Petit",
        "Moyen",
        "Grand",
        "Lourd",
        "Encombrant"
      ],
      "description": "Taille de l'emballage"
    },
    "delivery_time": {
      "type": "string",
      "enum": [
        "30-45 minutes",
        "24 heures",
        "3-5 jours",
        "15 jours"
      ],
      "description": "D\u00e9lai de livraison"
    },
    "stock_quantity": {
      "type": "number",
      "description": "Quantit\u00e9 disponible en stock",
      "default": 0
    },
    "seo_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags SEO pour la recherche"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "shop_id": {
      "type": "string",
      "description": "ID de l'entreprise propri\u00e9taire"
    },
    "shop_name": {
      "type": "string"
    },
    "customization_options": {
      "type": "object",
      "description": "Options de personnalisation disponibles",
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "hex": {
                "type": "string"
              },
              "additional_price": {
                "type": "number",
                "default": 0
              }
            }
          },
          "description": "Couleurs disponibles"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "additional_price": {
                "type": "number",
                "default": 0
              }
            }
          },
          "description": "Tailles disponibles"
        },
        "text_customization": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_characters": {
              "type": "number"
            },
            "price": {
              "type": "number"
            },
            "placeholder": {
              "type": "string"
            }
          },
          "description": "Personnalisation de texte/logo"
        },
        "arrangements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "additional_price": {
                "type": "number"
              }
            }
          },
          "description": "Arrangements personnalis\u00e9s"
        },
        "other_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "additional_price": {
                "type": "number"
              }
            }
          },
          "description": "Autres options personnalisables"
        }
      }
    },
    "product_attributes": {
      "type": "object",
      "description": "Attributs produits pour catalogues (Facebook/Google Shopping)",
      "properties": {
        "color": {
          "type": "string",
          "description": "Couleur principale du produit"
        },
        "size": {
          "type": "string",
          "description": "Taille (XS, S, M, L, XL, etc.)"
        },
        "material": {
          "type": "string",
          "description": "Mati\u00e8re (coton, polyester, cuir, etc.)"
        },
        "gender": {
          "type": "string",
          "enum": [
            "male",
            "female",
            "unisex"
          ],
          "description": "Genre cibl\u00e9"
        },
        "age_group": {
          "type": "string",
          "enum": [
            "adult",
            "kids",
            "toddler",
            "infant",
            "newborn"
          ],
          "description": "Groupe d'\u00e2ge"
        },
        "pattern": {
          "type": "string",
          "description": "Motif (ray\u00e9, uni, \u00e0 pois, etc.)"
        },
        "custom_labels": {
          "type": "object",
          "properties": {
            "label_0": {
              "type": "string"
            },
            "label_1": {
              "type": "string"
            },
            "label_2": {
              "type": "string"
            },
            "label_3": {
              "type": "string"
            },
            "label_4": {
              "type": "string"
            }
          },
          "description": "Labels personnalis\u00e9s pour filtrage dans Facebook/Google"
        }
      }
    }
  },
  "required": [
    "name",
    "price",
    "shop_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}