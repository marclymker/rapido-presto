{
  "name": "Contact",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Num\u00e9ro WhatsApp du contact (format 509XXXXXXXX)"
    },
    "full_name": {
      "type": "string",
      "description": "Nom complet du contact"
    },
    "email": {
      "type": "string",
      "description": "Email du contact"
    },
    "source": {
      "type": "string",
      "enum": [
        "whatsapp",
        "web",
        "agent",
        "import"
      ],
      "default": "whatsapp",
      "description": "Origine du contact"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "confirmed",
        "blocked"
      ],
      "default": "new",
      "description": "Statut du contact"
    },
    "last_message": {
      "type": "string",
      "description": "Aper\u00e7u du dernier message \u00e9chang\u00e9"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier \u00e9change"
    },
    "order_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs des commandes associ\u00e9es"
    },
    "confirmed_details": {
      "type": "object",
      "description": "D\u00e9tails confirm\u00e9s par l'agent (nom, adresse, etc.)",
      "properties": {
        "address": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "event_date": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes internes sur ce contact"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description/contexte suppl\u00e9mentaire"
    }
  },
  "required": [
    "phone"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}