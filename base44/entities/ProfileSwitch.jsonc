{
  "name": "ProfileSwitch",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "from_profile": {
      "type": "string",
      "enum": [
        "client",
        "entreprise",
        "livreur",
        "agent_vente"
      ]
    },
    "to_profile": {
      "type": "string",
      "enum": [
        "client",
        "entreprise",
        "livreur",
        "agent_vente"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Raison ou d\u00e9tails de la demande de changement de profil"
    },
    "data": {
      "type": "object",
      "description": "Donn\u00e9es sp\u00e9cifiques au profil demand\u00e9"
    },
    "approved_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "to_profile"
  ]
}