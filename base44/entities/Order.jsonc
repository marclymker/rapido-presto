{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "client_region": {
      "type": "string"
    },
    "client_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Coordonn\u00e9es GPS du client"
    },
    "shop_id": {
      "type": "string"
    },
    "shop_name": {
      "type": "string"
    },
    "shop_region": {
      "type": "string"
    },
    "shop_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Coordonn\u00e9es GPS de la boutique"
    },
    "driver_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "description": "Localisation en temps r\u00e9el du livreur"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "CASH",
        "card",
        "moncash",
        "natcash"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "moncash_transaction_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "preparing",
        "ready",
        "searching_driver",
        "driver_assigned",
        "in_delivery",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "delivery_type": {
      "type": "string",
      "enum": [
        "platform_delivery",
        "merchant_delivery"
      ],
      "description": "Type de livraison: par Rapido ou par le marchand"
    },
    "confirmation_code": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_phone": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notes ou instructions suppl\u00e9mentaires pour cette commande"
    }
  },
  "required": [
    "client_id",
    "shop_id",
    "items",
    "total"
  ]
}