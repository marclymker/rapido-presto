{
  "name": "Review",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID de la commande"
    },
    "client_id": {
      "type": "string",
      "description": "ID du client qui note"
    },
    "shop_id": {
      "type": "string",
      "description": "ID de la boutique"
    },
    "driver_id": {
      "type": "string",
      "description": "ID du livreur"
    },
    "shop_rating": {
      "type": "number",
      "description": "Note de la boutique (1-5)",
      "minimum": 1,
      "maximum": 5
    },
    "delivery_rating": {
      "type": "number",
      "description": "Note du livreur (1-5)",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "description": "Commentaire optionnel"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description d\u00e9taill\u00e9e de l'exp\u00e9rience client"
    }
  },
  "required": [
    "order_id",
    "client_id",
    "shop_id",
    "shop_rating",
    "delivery_rating"
  ]
}