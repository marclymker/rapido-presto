rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/User/$(request.auth.uid)).data.role in ['admin', 'owner']; }
    // UID Firebase vérifié du propriétaire Kairos. Ce repère ne dépend pas
    // d'un champ modifiable dans le profil utilisateur.
    function isSiteOwner() { return signedIn() && request.auth.uid == 'YG8mu1n9yEX0QxhCBLoSH6ao3Ol2'; }
    function publicCollection() { return resource.data.is_published == true || resource.data.is_active == true || resource.data.is_available == true; }

    match /User/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && (!request.resource.data.keys().hasAny(['role', 'is_admin', 'is_owner'])
          || (request.resource.data.role == 'client' && request.resource.data.is_owner != true));
      allow update: if isAdmin() || (isOwner(uid)
        && (!resource.data.keys().hasAny(['role', 'is_admin']) || request.resource.data.role == resource.data.role)
        && (!resource.data.keys().hasAny(['is_admin']) || request.resource.data.is_admin == resource.data.is_admin)
        && (!resource.data.keys().hasAny(['is_owner']) || request.resource.data.is_owner == resource.data.is_owner));
      allow delete: if isAdmin();
    }
    match /MigrationLink/{id} { allow read, write: if isAdmin(); }
    match /UserActivity/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }
    match /Product/{id} {
      allow read: if publicCollection() || signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.owner_id == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && (resource.data.owner_id == request.auth.uid || resource.data.vendor_id == request.auth.uid)
        && request.resource.data.owner_id == resource.data.owner_id);
      allow delete: if isAdmin() || (signedIn() && (resource.data.owner_id == request.auth.uid || resource.data.vendor_id == request.auth.uid));
    }
    match /Shop/{id} {
      allow read: if publicCollection() || signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.user_id == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == resource.data.user_id);
      allow delete: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
    }
    match /BlogArticle/{id} { allow read: if resource.data.is_published == true || isAdmin(); allow write: if isAdmin(); }
    match /MarketingDraft/{id} {
      allow read, update, delete: if isSiteOwner() && resource.data.user_id == request.auth.uid;
      allow create: if isSiteOwner() && request.resource.data.user_id == request.auth.uid;
    }
    match /CartItem/{id} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
    }
    match /Order/{id} {
      allow read: if signedIn() && (resource.data.client_id == request.auth.uid || resource.data.driver_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.client_id == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && (resource.data.client_id == request.auth.uid || resource.data.driver_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid));
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
