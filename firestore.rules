rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'makariosentreprises@gmail.com'; }
    // UID Firebase vérifié du propriétaire Kairos. Ce repère ne dépend pas
    // d'un champ modifiable dans le profil utilisateur.
    function isSiteOwner() { return signedIn() && request.auth.uid == 'YG8mu1n9yEX0QxhCBLoSH6ao3Ol2'; }
    function publicCollection() { return resource.data.is_published == true || resource.data.is_active == true || resource.data.is_available == true; }

    match /User/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && (!request.resource.data.keys().hasAny(['role', 'is_admin', 'is_owner'])
          || (request.resource.data.role == 'client' && request.resource.data.is_owner != true));
      allow update: if isAdmin() || (isOwner(uid)
        // Les anciens comptes peuvent ne pas avoir de champ email, mais si le champ
        // existe il doit toujours rester celui du compte Firebase authentifié.
        && (!resource.data.keys().hasAny(['email'])
          ? request.resource.data.get('email', request.auth.token.email) == request.auth.token.email
          : request.resource.data.email == resource.data.email)
        // Aucun utilisateur ne peut ajouter ou modifier un rôle, un statut admin ou owner.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_admin', 'is_owner']));
      allow delete: if isAdmin();
    }
    match /MigrationLink/{id} { allow read, write: if isAdmin(); }
    match /UserActivity/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }
    match /Product/{id} {
      allow read: if publicCollection() || signedIn();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && (!request.resource.data.keys().hasAny(['vendor_id']) || request.resource.data.vendor_id == request.auth.uid));
      allow update: if isAdmin() || (signedIn()
        && (resource.data.owner_id == request.auth.uid || resource.data.vendor_id == request.auth.uid)
        && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.get('vendor_id', null) == resource.data.get('vendor_id', null));
      allow delete: if isAdmin() || (signedIn() && (resource.data.owner_id == request.auth.uid || resource.data.vendor_id == request.auth.uid));
    }
    match /Shop/{id} {
      allow read: if publicCollection() || signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.user_id == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == resource.data.user_id);
      allow delete: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
    }
    match /Conversation/{id} {
      allow read: if signedIn() && (resource.data.customer_id == request.auth.uid || resource.data.vendor_id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customer_id == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.customer_id == request.auth.uid || resource.data.vendor_id == request.auth.uid)
        && request.resource.data.customer_id == resource.data.customer_id
        && request.resource.data.vendor_id == resource.data.vendor_id;
      allow delete: if signedIn() && (resource.data.customer_id == request.auth.uid || resource.data.vendor_id == request.auth.uid);
    }
    match /ConversationMessage/{id} {
      allow read: if signedIn()
        && (get(/databases/$(database)/documents/Conversation/$(resource.data.conversation_id)).data.customer_id == request.auth.uid
          || get(/databases/$(database)/documents/Conversation/$(resource.data.conversation_id)).data.vendor_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.sender_id == request.auth.uid
        && (get(/databases/$(database)/documents/Conversation/$(request.resource.data.conversation_id)).data.customer_id == request.auth.uid
          || get(/databases/$(database)/documents/Conversation/$(request.resource.data.conversation_id)).data.vendor_id == request.auth.uid);
      allow update: if signedIn() && resource.data.sender_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.sender_id == request.auth.uid;
    }
    match /BlogArticle/{id} { allow read: if resource.data.is_published == true || isAdmin(); allow write: if isAdmin(); }
    match /MarketingDraft/{id} {
      allow read, update, delete: if isSiteOwner() && resource.data.user_id == request.auth.uid;
      allow create: if isSiteOwner() && request.resource.data.user_id == request.auth.uid;
    }
    match /CartItem/{id} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
    }
    match /Order/{id} {
      allow read: if signedIn() && (resource.data.client_id == request.auth.uid || resource.data.driver_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.client_id == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.client_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['special_instructions', 'client_phone', 'client_address', 'updated_date'])
          && request.resource.data.total == resource.data.total
          && request.resource.data.subtotal == resource.data.subtotal
          && request.resource.data.get('payment_status', null) == resource.data.get('payment_status', null)
          && request.resource.data.get('payment_provider', null) == resource.data.get('payment_provider', null)
          && request.resource.data.get('payment_transaction_id', null) == resource.data.get('payment_transaction_id', null))
        || (signedIn() && (resource.data.driver_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'delivery_status', 'driver_id', 'driver_name', 'updated_date', 'accepted_at', 'rejected_at', 'ready_at', 'delivered_at', 'notes']));
      allow delete: if isAdmin();
    }
    match /Reservation/{id} {
      allow create: if signedIn() && request.resource.data.client_id == request.auth.uid;
      allow read: if signedIn() && (resource.data.client_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        || (signedIn() && resource.data.shop_owner_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmation_note', 'confirmed_at', 'rejected_at', 'updated_date']))
        || (signedIn() && resource.data.client_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client_phone', 'client_note', 'updated_date']));
      allow delete: if isAdmin() || (signedIn() && resource.data.client_id == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
